server {
    listen ${PORT};
    server_name _;

    client_max_body_size 20M;
    resolver ${NGINX_RESOLVER} valid=10s ipv6=on;

    set $web_upstream ${WEB_HOST}:${WEB_PORT};
    set $admin_upstream ${ADMIN_HOST}:${ADMIN_PORT};
    set $api_upstream ${API_HOST}:${API_PORT};

    location = /health {
        access_log off;
        return 200 'OK';
        add_header Content-Type text/plain;
    }

    location /api {
        proxy_pass http://$api_upstream;

        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Connection "";

        proxy_cache_bypass $http_pragma;
        proxy_no_cache $http_pragma;

        limit_req zone=api burst=20 nodelay;
    }

    location /admin/ {
        proxy_pass http://$admin_upstream;

        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Connection "";

        proxy_cache_bypass $http_pragma;
        proxy_no_cache $http_pragma;

        limit_req zone=admin burst=10 nodelay;
    }

    location = /admin {
        proxy_pass http://$admin_upstream;

        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Connection "";

        proxy_cache_bypass $http_pragma;
        proxy_no_cache $http_pragma;

        limit_req zone=admin burst=10 nodelay;
    }

    location /api/storage/ {
        proxy_pass http://$api_upstream;

        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Connection "";

        proxy_cache games_assets;
        proxy_cache_valid 200 1d;
        proxy_cache_key $request_uri;
        add_header X-Cache-Status $upstream_cache_status always;

        proxy_cache_bypass $http_pragma;
        proxy_no_cache $http_pragma;

        limit_req zone=api burst=20 nodelay;
    }

    location = /api/proxy-image {
        proxy_pass http://$api_upstream;

        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Connection "";

        proxy_cache api_proxy;
        proxy_cache_valid 200 1d;
        proxy_cache_key $request_uri;
        add_header X-Cache-Status $upstream_cache_status always;

        proxy_cache_bypass $http_pragma;
        proxy_no_cache $http_pragma;

        limit_req zone=api burst=20 nodelay;
    }

    location / {
        proxy_pass http://$web_upstream;

        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Connection "";

        proxy_cache_bypass $http_pragma;
        proxy_no_cache $http_pragma;

        limit_req zone=general burst=50 nodelay;
    }
}
